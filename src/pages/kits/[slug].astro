---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import StorefrontDialogs from '../../components/StorefrontDialogs.astro';
import StorefrontScripts from '../../components/StorefrontScripts.astro';
import { products, programming, productStructuredData, type Product } from '../../data/store';

export const prerender = true;
export function getStaticPaths() {
	return products.map((product, index) => ({ params: { slug: product.slug }, props: { product, index } }));
}
interface Props { product: Product; index: number }
const { product, index } = Astro.props;
const title = `${product.name} — ${product.model} | Signal Ready`;
const description = `${product.name} with ${product.model} radios, ${product.battery} batteries, a fitted hard case, charging cables, and programming. ${product.price} with free U.S. shipping.`;
const specs = [
	['Radio model', product.model],
	['Radios included', product.radioCount],
	['Battery capacity', `${product.battery} per radio`],
	['Case exterior (L × W × H)', product.caseSize],
	['Charging cables', product.charging],
	['Shipping', 'Free within the United States'],
];
const breadcrumbs = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Radio kits', item: 'https://radios.ansman.io/' },
		{ '@type': 'ListItem', position: 2, name: product.name, item: `https://radios.ansman.io${product.path}` },
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} canonicalPath={product.path}
			image={product.images[0].src} imageAlt={product.images[0].alt}
			imageType="image/jpeg" imageWidth={1086} imageHeight={1448} />
		<meta name="theme-color" content="#303a31" />
		<script type="application/ld+json" set:html={JSON.stringify(productStructuredData(product))}></script>
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)}></script>
	</head>
	<body>
		<SiteHeader />
		<main class="kit-page" id="main">
			<noscript><p class="noscript-notice">PayPal checkout requires JavaScript. <a href={`mailto:ansman@gmail.com?subject=${encodeURIComponent(`Signal Ready — ${product.name}`)}`}>Email Signal Ready to order this kit.</a></p></noscript>
			<nav class="kit-breadcrumbs" aria-label="Breadcrumb">
				<a href="/#shop">All radio kits</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span>
			</nav>
			<nav class="kit-switcher" aria-label="Browse radio kits">
				{products.map(kit => <a href={kit.path} aria-current={kit.id === product.id ? 'page' : undefined}>
					<strong>{kit.radioCount}-Radio Kit</strong><span>{kit.price}</span>
				</a>)}
			</nav>

			<article class="kit-overview product-card" id={product.id} aria-labelledby="kit-title">
				<ProductGallery product={product} index={index} />
				<div class="product-info">
					<p class="product-model">{product.model} · {product.label}</p>
					<h1 id="kit-title">{product.name}</h1>
					<p class="product-description">{product.description}</p>
					<p class="product-fit"><span>Best for</span>{product.bestFor}</p>
					<div class="product-purchase">
						<div class="product-price">{product.price}<span>Free U.S. shipping</span></div>
						<button class="button-buy" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`} aria-label={`Buy ${product.name} online`} aria-haspopup="dialog" aria-controls={`paypal-product-dialog-${product.id}`}>Buy online <span aria-hidden="true">→</span></button>
					</div>
					<p class="kit-checkout-note">Choose badge wording and any available options in the PayPal cart.</p>
					<div class="kit-overview-links">
						<a href="#kit-details">What's included <span aria-hidden="true">↓</span></a>
						<a href="/#compare">Compare all kits <span aria-hidden="true">→</span></a>
					</div>
				</div>
			</article>

			<div class="kit-details-grid" aria-label="Included equipment and specifications">
				<details class="kit-detail-panel kit-disclosure" id="kit-details">
					<summary>What's included <span aria-hidden="true">+</span></summary>
					<ul class="check-list">{product.included.map(item => <li>{item}</li>)}</ul>
					<p class="kit-programming-note">Pre-programmed with {programming.join(', ')}. Custom channel plans are available upon request.</p>
				</details>
				<details class="kit-detail-panel kit-disclosure" id="kit-specifications">
					<summary>Specifications <span aria-hidden="true">+</span></summary>
					<dl class="kit-specs">{specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
				</details>
			</div>
			<details class="item-description kit-description">
				<summary>Full product description <span aria-hidden="true">+</span></summary>
				<p>{product.fullDescription}</p>
			</details>

			<p class="kit-help">Questions about range, batteries, or custom options? <a href="/#faq">Read the FAQ</a> or <a href={`mailto:ansman@gmail.com?subject=${encodeURIComponent(`Question about the ${product.name}`)}`}>ask the builder</a>.</p>
		</main>
		<SiteFooter />
		<StorefrontDialogs products={[product]} />
		<StorefrontScripts />
	</body>
</html>
