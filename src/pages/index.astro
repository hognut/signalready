---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const products = [
	{
		id: 'four-radio-kit',
		name: '4-Radio Field Kit',
		model: 'Baofeng UV-5R Mini',
		price: '$200',
		paypalId: '7L264VEBTJMMQ',
		label: 'Complete system',
		bestFor: 'Families, teams, and preparedness kits',
		description: 'A compact four-radio communications package, professionally programmed and organized for immediate deployment.',
		highlights: ['Four-radio team setup', 'Custom programming', '1-to-4 USB-C charging'],
		images: [
			{ src: '/images/four-kit-open.jpg', alt: 'Four Baofeng handheld radios beside an open Signal Ready hard case' },
			{ src: '/images/four-kit-packed.jpg', alt: 'Four radios and charging accessories organized inside a protective hard case' },
			{ src: '/images/four-kit-closed.jpg', alt: 'Closed black protective radio case in a charcoal studio with lime edge lighting' },
		],
		included: [
			'4 Baofeng UV-5R Mini HAM-version radios',
			'Rechargeable batteries installed',
			'Custom-fitted protective hard case',
			'Precision-cut foam insert',
			'1-to-4 USB-C charging splitter',
			'Custom exterior identification badge',
			'Case exterior: 9¼ × 7½ × 4⅜ in.',
		],
	},
	{
		id: 'two-radio-kit',
		name: '2-Radio Field Kit',
		model: 'Baofeng Mini-5',
		selectorBadge: 'Next-generation radio',
		selectorModel: 'Mini-5 · 2,200mAh',
		price: '$125',
		paypalId: 'ZZL7S6UZS5VKN',
		label: 'Newer-generation radio',
		bestFor: 'Vehicles, couples, travel, and small teams',
		description: 'Built around the newer Baofeng Mini-5, with a 2,200mAh battery, improved audio and reception, and an easier-to-use keypad—all in a streamlined package for vehicles, travel, and small teams.',
		highlights: ['Newer Mini-5 platform', '2,200mAh battery', 'Improved audio, reception, and keypad'],
		images: [
			{ src: '/images/two-kit-open.jpg', alt: 'Two Baofeng handheld radios beside an open protective hard case' },
			{ src: '/images/two-kit-packed.jpg', alt: 'Two radios and charging accessories secured inside a fitted hard case' },
			{ src: '/images/two-kit-closed.jpg', alt: 'Closed black two-radio kit case with a compact black USB-C splitter cable' },
		],
		included: [
			'2 Baofeng Mini-5 HAM-version radios',
			'2,200mAh rechargeable batteries installed',
			'Custom-fitted protective hard case',
			'Precision-cut foam insert',
			'1-to-2 USB-C charging splitter',
			'Custom exterior identification badge',
			'Case exterior: 9¼ × 7½ × 4⅜ in.',
		],
	},
	{
		id: 'five-radio-kit',
		name: '5-Radio Field Kit',
		model: 'Baofeng Mini-5',
		selectorBadge: 'Next-generation radio',
		selectorModel: '5 × Mini-5 · 2,200mAh',
		price: '$300',
		paypalId: null,
		label: 'Next-generation team system',
		bestFor: 'Larger teams, events, families, and field operations',
		description: 'Built around five next-generation Baofeng Mini-5 radios, each with a 2,200mAh battery, improved audio and reception, and an easier-to-use keypad—all organized in a larger five-slot field case.',
		highlights: ['Five next-gen Mini-5 radios', '2,200mAh batteries', 'Improved audio, reception, and keypad'],
		images: [
			{ src: '/images/five-kit-radios-open.jpg', alt: 'Five next-generation Baofeng Mini-5 radios beside an open five-slot protective hard case' },
			{ src: '/images/five-kit-radios-packed.jpg', alt: 'Five next-generation Mini-5 radios secured inside custom-cut foam in the larger field case' },
			{ src: '/images/five-kit-closed.jpg', alt: 'Closed large black five-radio protective case in the Signal Ready studio' },
			{ src: '/images/five-kit-size-comparison.jpg', alt: 'Large five-radio case beneath the smaller case used for two- and four-radio kits' },
		],
		included: [
			'5 Baofeng Mini-5 HAM-version radios',
			'2,200mAh rechargeable batteries installed',
			'Larger protective hard case',
			'Precision-cut five-slot foam insert',
			'USB-C multi-charging solution',
			'Custom exterior identification badge',
			'Free shipping within the United States',
		],
	},
];

const programming = ['GMRS channels', 'FRS channels', 'NOAA weather', 'Marine channels', 'Aviation monitoring'];

const faqs = [
	{
		question: 'How far can these handheld radios transmit?',
		answer: 'Handheld-to-handheld range is usually measured in a few miles on flat, relatively clear terrain—not the maximum-range numbers often printed on packaging. Buildings, hills, dense woods, vehicles, and low antenna height can cut that sharply. High ground, clear line of sight, a suitable antenna, or an authorized repeater can extend range dramatically.',
	},
	{
		question: 'How long do the batteries last, and which radio has the larger battery?',
		answer: 'The UV-5R Mini uses a 1,600mAh battery. The next-generation Mini-5 included in the 2- and 5-radio kits has a 2,200mAh battery—600mAh, or 37.5%, more rated capacity. A full charge can often cover a day of light, intermittent use; heavy transmitting, high power, scanning, cold weather, and battery age shorten runtime. The larger capacity does not guarantee 37.5% longer runtime because the two radios can draw power differently. USB-C makes vehicle or power-bank top-ups easy.',
	},
	{
		question: 'What is the difference between HAM, GMRS, and FRS?',
		answer: 'Amateur radio (HAM) offers broad frequency privileges and repeater access but requires passing an exam for an individual FCC license. GMRS requires a no-exam FCC license and certified GMRS equipment; one individual license normally covers the license holder and immediate family. FRS is license-free but must be used with compliant FRS radios.',
	},
	{
		question: 'Do I need a license?',
		answer: 'Receiving ordinary over-the-air signals generally does not require a radio license. Transmitting on amateur bands requires the appropriate amateur license, and transmitting on GMRS requires a GMRS license. FRS does not require an individual license when used with an FCC-compliant FRS radio. The operator is always responsible for the service, frequency, and equipment rules.',
	},
	{
		question: 'Can a HAM-version radio transmit on GMRS, FRS, Marine, or Aviation channels?',
		answer: 'Programming a channel does not certify the radio for that service or authorize transmission. These kits contain HAM-version transceivers, so GMRS, FRS, Marine, Aviation, and NOAA entries may be provided for monitoring where lawful. Transmit only when both the operator and the equipment are authorized for that radio service; NOAA and Aviation channels in these kits are receive-only.',
	},
	{
		question: 'Do “privacy codes” make a conversation private?',
		answer: 'No. CTCSS and DCS tones only filter which signals open your radio’s speaker. Anyone listening on the same frequency without that filter can still hear the transmission. They reduce unwanted chatter; they do not encrypt it.',
	},
	{
		question: 'Will these radios communicate with other brands?',
		answer: 'Usually yes when the radios use the same legal radio service, frequency, channel width, tone settings, and repeater configuration. Brand names do not have to match. Signal Ready can help coordinate a compatible channel plan for your team’s existing equipment.',
	},
	{
		question: 'Does programming increase range?',
		answer: 'No. Programming makes the radio faster and easier to use, but range depends mainly on antenna height and quality, terrain, obstructions, frequency, transmit power, and repeater access. Moving to higher, clearer ground is often the most effective improvement.',
	},
];

const storeSchema = {
	'@context': 'https://schema.org',
	'@type': 'OnlineStore',
	name: 'Signal Ready',
	url: 'https://radios.ansman.io',
	email: 'ansman@gmail.com',
	description: SITE_DESCRIPTION,
	areaServed: 'US',
	currenciesAccepted: 'USD',
	paymentAccepted: 'PayPal',
	slogan: 'Ready when networks fail.',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(faq => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/og-v2.png" />
		<meta name="theme-color" content="#2a312a" />
		<script type="application/ld+json" set:html={JSON.stringify(storeSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="utility-bar">
			<div><span>Free shipping</span> anywhere in the United States</div>
			<div>Assembled in Maryland <i aria-hidden="true"></i> Veteran owned business</div>
		</div>

		<header class="site-header">
			<a class="brand" href="#top" aria-label="Signal Ready home">
				<img class="brand-logo" src="/images/signal-ready-logo-lime.png" alt="" width="40" height="40" />
				<span>SIGNAL <strong>READY</strong></span>
			</a>
			<nav aria-label="Main navigation">
				<a href="#shop">Shop</a>
				<a href="#how-it-works">How it works</a>
				<a href="#field-ready">What you get</a>
				<a href="#faq">FAQ</a>
				<a href="#about">About</a>
				<a href="#policies">Policies</a>
			</nav>
			<details class="mobile-menu">
				<summary>Menu</summary>
				<nav aria-label="Mobile navigation">
					<a href="#shop">Shop</a>
					<a href="#how-it-works">How it works</a>
					<a href="#field-ready">What you get</a>
					<a href="#faq">FAQ</a>
					<a href="#about">About</a>
					<a href="#policies">Policies</a>
				</nav>
			</details>
			<div class="cart-control" aria-label="Shopping cart">
				<paypal-cart-button data-id="pp-view-cart"></paypal-cart-button>
			</div>
		</header>

		<main id="main">
			<noscript><p class="noscript-notice">PayPal checkout requires JavaScript. <a href="mailto:ansman@gmail.com?subject=Signal%20Ready%20order">Email Signal Ready to order.</a></p></noscript>
			<section class="hero" id="top">
				<div class="hero-copy">
					<p class="eyebrow">Field-ready communication systems</p>
					<h1>Ready when<br /><em>networks fail.</em></h1>
					<p class="lede">Professionally assembled, pre-programmed radio kits built for preparedness, travel, team coordination, and off-grid communication.</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#shop">Shop the systems <span aria-hidden="true">↓</span></a>
						<div class="availability"><span aria-hidden="true"></span> Built and shipped from Maryland</div>
					</div>
				</div>
				<div class="hero-visual">
					<div class="image-frame">
						<img src="/images/hero-field-kit.jpg" alt="Four handheld radios, an open protective case, and a charging cable arranged on a truck tailgate at dusk" width="1350" height="1800" fetchpriority="high" />
					</div>
					<div class="hero-image-label"><span>SR–04</span><strong>Field system</strong></div>
					<div class="status-card"><span aria-hidden="true"></span> Programmed · Packed · Ready</div>
					<div class="coordinates" aria-hidden="true">38.7218° N<br />76.6605° W</div>
				</div>
			</section>

			<section class="trust-strip" aria-label="Store benefits">
				<div><strong>01</strong><span>Pre-programmed<br />before delivery</span></div>
				<div><strong>02</strong><span>Organized in a<br />custom foam case</span></div>
				<div><strong>03</strong><span>Free shipping<br />across the U.S.</span></div>
				<div><strong>04</strong><span>Veteran owned<br />business</span></div>
			</section>

			<section class="process-section" id="how-it-works" aria-labelledby="process-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">From the bench to your door</p>
						<h2 id="process-title">Ready in<br />three steps.</h2>
					</div>
					<p>No complicated setup list. Choose the right kit, tell us what you need, and receive an organized system ready for the field.</p>
				</div>
				<ol class="process-grid">
					<li><span>01</span><h3>Choose your system</h3><p>Select a complete two-, four-, or five-radio kit for your household, vehicle, or team.</p></li>
					<li><span>02</span><h3>We configure it</h3><p>Your complete radio kit is programmed, checked, organized, and packed in Maryland.</p></li>
					<li><span>03</span><h3>It ships free</h3><p>Your order ships free anywhere in the United States, with direct support from the builder.</p></li>
				</ol>
			</section>

			<section class="shop-section" id="shop">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Choose your setup</p>
						<h2>Built for the field.<br />Not the shelf.</h2>
					</div>
					<p>Every system is carefully organized and prepared for quick deployment—without a complicated setup process.</p>
				</div>

				<div class="setup-selector" aria-label="Compare Signal Ready setups">
					{products.map((product, index) => (
						<article class="setup-option">
							<div class="setup-option-top">
								<span>{String(index + 1).padStart(2, '0')}</span>
								<small>{product.paypalId ? 'Ready to order' : 'Ask about availability'}</small>
							</div>
							<div class="setup-option-visual">
								<img class="setup-option-image" src={product.images[0].src} alt="" width="1086" height="1448" loading="lazy" decoding="async" />
								<div class="setup-option-copy">
									{product.selectorBadge && <span class="setup-option-badge">{product.selectorBadge}</span>}
									<a class="setup-option-title" href={`#${product.id}`}>{product.name}</a>
									<p>{product.bestFor}</p>
								</div>
							</div>
							<div class="setup-option-meta"><b>{product.price}</b><em>{product.selectorModel ?? product.model}</em></div>
							{product.paypalId ? (
								<button class="setup-buy-button" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`} aria-label={`Buy ${product.name} online`}>
									<span>Buy online</span><b aria-hidden="true">→</b>
								</button>
							) : (
								<a class="setup-buy-button" href={`mailto:ansman@gmail.com?subject=${encodeURIComponent(`Signal Ready — ${product.name}`)}`}><span>Ask about availability</span><b aria-hidden="true">→</b></a>
							)}
						</article>
					))}
				</div>

				<div class="product-grid">
					{products.map((product, index) => (
						<article class="product-card" id={product.id}>
							<div class="product-gallery" data-gallery>
								<div class="product-label"><span>{String(index + 1).padStart(2, '0')}</span>{product.label}</div>
								<img class="product-main-image" src={product.images[0].src} alt={product.images[0].alt} width="1086" height="1448" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" data-main-image />
								<div class="product-thumbnails" aria-label={`${product.name} photos`}>
									{product.images.map((image, imageIndex) => (
										<button type="button" class:list={{ active: imageIndex === 0 }} data-gallery-button data-src={image.src} data-alt={image.alt} aria-label={`Show ${product.name} photo ${imageIndex + 1}`} aria-pressed={imageIndex === 0 ? 'true' : 'false'}>
											<img src={image.src} alt="" width="72" height="72" loading="lazy" decoding="async" />
										</button>
									))}
								</div>
							</div>
							<div class="product-info">
								<p class="product-model">{product.model}</p>
								<h3>{product.name}</h3>
								<p class="product-description">{product.description}</p>
								<ul class="product-highlights" aria-label={`${product.name} highlights`}>
									{product.highlights.map(item => <li>{item}</li>)}
								</ul>
								<ul class="check-list">
									{product.included.map(item => <li>{item}</li>)}
								</ul>
								<div class="product-purchase">
									<div class="product-price">{product.price}<span>Free U.S. shipping</span></div>
									{product.paypalId ? (
										<button class="button-buy" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`}>Configure & add to cart</button>
									) : (
										<a class="button-inquiry" href={`mailto:ansman@gmail.com?subject=${encodeURIComponent(`Signal Ready — ${product.name}`)}`}>Ask about availability</a>
									)}
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="brand-banner" aria-label="Signal Ready brand promise">
				<div class="brand-banner-index" aria-hidden="true">SR<span>01</span></div>
				<div class="brand-banner-copy">
					<p class="eyebrow">Veteran owned · Built in Maryland</p>
					<h2>Purpose-built.<br /><em>Field ready.</em></h2>
				</div>
				<div class="brand-banner-notes">
					<span>Programmed before delivery</span>
					<span>Free shipping across the U.S.</span>
					<span>Direct support from the builder</span>
				</div>
			</section>

			<section class="field-ready" id="field-ready">
				<div class="field-ready-copy">
					<p class="eyebrow">Configured before it ships</p>
					<h2>No setup.<br /><em>No guesswork.</em></h2>
					<p>Radio kits arrive organized and pre-programmed with a practical field configuration. Additional custom channel configurations are available upon request.</p>
					<a class="text-link" href="mailto:ansman@gmail.com?subject=Signal%20Ready%20custom%20configuration">Ask about a custom configuration <span aria-hidden="true">→</span></a>
				</div>
				<div class="channel-panel">
					<div class="panel-head"><span>Standard channel groups</span><span>SR–01</span></div>
					<ol>
						{programming.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}<i aria-hidden="true"></i></li>)}
					</ol>
					<p>Frequency availability and transmit authorization depend on radio service, licensing, location, and applicable regulations.</p>
				</div>
			</section>

			<section class="about-section" id="about">
				<div class="about-number" aria-hidden="true">SR</div>
				<div class="about-copy">
					<p class="eyebrow">Why Signal Ready</p>
					<h2>Communication should still work when everything else doesn’t.</h2>
					<div class="about-columns">
						<p>Signal Ready builds portable radio systems for people who value reliability, simplicity, and fast deployment.</p>
						<p>Whether you are preparing a family emergency kit, outfitting a vehicle recovery team, coordinating an event, or traveling off-grid, every kit is assembled to be practical, durable, and easy to use.</p>
					</div>
				</div>
			</section>

			<section class="use-cases" aria-labelledby="use-cases-title">
				<div class="section-heading compact">
					<div><p class="eyebrow">Made to move</p><h2 id="use-cases-title">One system.<br />Plenty of missions.</h2></div>
				</div>
				<div class="use-grid">
					<span>Emergency preparedness</span><span>Camping & overlanding</span><span>Vehicle recovery</span><span>Event coordination</span><span>Family communication</span><span>Travel & off-grid use</span>
				</div>
			</section>

			<section class="faq-section" id="faq" aria-labelledby="faq-title">
				<div class="section-heading">
					<div><p class="eyebrow">HAM + GMRS basics</p><h2 id="faq-title">Frequently asked<br />questions.</h2></div>
					<p>Realistic guidance about range, batteries, compatibility, licensing, and responsible operation before you head into the field.</p>
				</div>
				<div class="faq-grid">
					{faqs.map((faq, index) => (
						<details class="faq-item" open={index === 0}>
							<summary>
								<span class="faq-number">{String(index + 1).padStart(2, '0')}</span>
								<strong>{faq.question}</strong>
								<span class="faq-toggle" aria-hidden="true">+</span>
							</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
				<p class="faq-sources">Information last reviewed August 2026. Radio regulations and manufacturer specifications can change; confirm current FCC rules and the battery label supplied with your kit.</p>
			</section>

			<section class="policy-section" id="policies">
				<div class="section-heading compact">
					<div><p class="eyebrow">Straightforward policies</p><h2>Know before<br />you order.</h2></div>
				</div>
				<div class="policy-grid">
					<div><span>Shipping</span><h3>Free. Every day.</h3><p>All orders ship free to addresses within the United States. International shipping is not currently available.</p></div>
					<div><span>Ownership</span><h3>Veteran owned business.</h3><p>Signal Ready is proudly veteran owned and focused on practical, dependable communication systems.</p></div>
					<div><span>Support</span><h3>Talk to the builder.</h3><p>Questions about a system, custom badge, or channel configuration? Email <a href="mailto:ansman@gmail.com">ansman@gmail.com</a>.</p></div>
					<div><span>Payment</span><h3>Checkout by PayPal.</h3><p>Payments and payment details are handled securely by PayPal. This storefront does not store your payment card information.</p></div>
				</div>
			</section>

			<section class="legal-note" aria-labelledby="legal-title">
				<h2 id="legal-title">Responsible radio use</h2>
				<p>The user is responsible for proper licensing, frequency use, and legal operation where applicable. Some frequencies may be programmed for monitoring only depending on local laws, radio service rules, and licensing requirements.</p>
			</section>
		</main>

		<footer>
			<div class="footer-main">
				<a class="brand footer-brand" href="#top">
					<img class="brand-logo" src="/images/signal-ready-logo-lime.png" alt="" width="40" height="40" loading="lazy" />
					<span>SIGNAL <strong>READY</strong></span>
				</a>
				<p>Field-ready communication systems.<br />Built in Dunkirk, Maryland.</p>
				<a class="footer-email" href="mailto:ansman@gmail.com">ansman@gmail.com</a>
			</div>
			<div class="footer-bottom">
				<span>© {new Date().getFullYear()} Signal Ready</span>
				<span>Free U.S. shipping · Veteran owned business</span>
			</div>
		</footer>

		{products.filter(product => product.paypalId).map(product => (
			<dialog class="paypal-dialog" id={`paypal-product-dialog-${product.id}`} aria-labelledby={`paypal-dialog-title-${product.id}`} data-paypal-dialog>
				<div class="paypal-dialog-inner">
					<div class="paypal-dialog-header">
						<div>
							<p class="eyebrow">Secure PayPal checkout</p>
							<h2 id={`paypal-dialog-title-${product.id}`}>Configure your {product.name.toLowerCase()}</h2>
						</div>
						<form method="dialog"><button class="dialog-close" type="submit" aria-label={`Close ${product.name} checkout`}>Close</button></form>
					</div>
					<div class="paypal-dialog-body">
						<paypal-add-to-cart-button data-id={product.paypalId}></paypal-add-to-cart-button>
					</div>
				</div>
			</dialog>
		))}

		<script is:inline src="https://www.paypalobjects.com/ncp/cart/cart.js" data-merchant-id="Z3JCP68TFDYL8"></script>
		<script is:inline>
			const alignInitialShortcut = () => {
				if (window.location.hash.length < 2) return;
				const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
				if (!target) return;
				const root = document.documentElement;
				const previousBehavior = root.style.scrollBehavior;
				root.style.scrollBehavior = 'auto';
				target.scrollIntoView({ block: 'start' });
				root.style.scrollBehavior = previousBehavior;
			};

			window.addEventListener('load', () => {
				Promise.resolve(document.fonts?.ready).then(() => {
					requestAnimationFrame(() => requestAnimationFrame(alignInitialShortcut));
				});
			}, { once: true });

			document.querySelectorAll('[data-gallery]').forEach((gallery) => {
				const mainImage = gallery.querySelector('[data-main-image]');
				gallery.querySelectorAll('[data-gallery-button]').forEach((button) => {
					button.addEventListener('click', () => {
						if (!(mainImage instanceof HTMLImageElement) || !(button instanceof HTMLElement)) return;
						mainImage.src = button.dataset.src || mainImage.src;
						mainImage.alt = button.dataset.alt || mainImage.alt;
						gallery.querySelectorAll('[data-gallery-button]').forEach((item) => {
							item.classList.toggle('active', item === button);
							item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
						});
					});
				});
			});

			const mobileMenu = document.querySelector('.mobile-menu');
			mobileMenu?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
			});

			const paypalDialogs = document.querySelectorAll('[data-paypal-dialog]');
			const purchaseButtons = document.querySelectorAll('[data-open-paypal]');
			let paypalReady = false;

			try {
				if (window.cartPaypal) {
					window.cartPaypal.Cart({ id: 'pp-view-cart' });
					document.querySelectorAll('paypal-add-to-cart-button[data-id]').forEach((element) => {
						const id = element.getAttribute('data-id');
						if (id) window.cartPaypal.AddToCart({ id });
					});
					paypalReady = true;
				}
			} catch {
				paypalReady = false;
			}

			if (paypalReady) {
				purchaseButtons.forEach((button) => {
					button.addEventListener('click', () => {
						if (!(button instanceof HTMLElement)) return;
						const dialog = document.getElementById(button.dataset.dialogId || '');
						if (dialog instanceof HTMLDialogElement) dialog.showModal();
					});
				});
			} else {
				const cartControl = document.querySelector('.cart-control');
				if (cartControl) {
					cartControl.replaceChildren();
					const fallbackLink = document.createElement('a');
					fallbackLink.className = 'cart-fallback';
					fallbackLink.href = 'mailto:ansman@gmail.com?subject=Signal%20Ready%20order';
					fallbackLink.textContent = 'Order by email';
					cartControl.append(fallbackLink);
				}
				purchaseButtons.forEach((button) => {
					button.textContent = 'Email to order';
					button.addEventListener('click', () => {
						if (!(button instanceof HTMLElement)) return;
						const subject = encodeURIComponent(button.dataset.emailSubject || 'Signal Ready order');
						window.location.href = `mailto:ansman@gmail.com?subject=${subject}`;
					});
				});
			}

			paypalDialogs.forEach((dialog) => {
				dialog.addEventListener('click', (event) => {
					if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
				});
			});
		</script>
	</body>
</html>
