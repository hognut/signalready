---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FaqList from '../components/FaqList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StorefrontDialogs from '../components/StorefrontDialogs.astro';
import StorefrontScripts from '../components/StorefrontScripts.astro';
import { products, faqs, productStructuredData } from '../data/store';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const storeSchema = {
	'@context': 'https://schema.org',
	'@type': 'OnlineStore',
	name: 'Signal Ready',
	url: 'https://radios.ansman.io',
	email: 'ansman@gmail.com',
	description: SITE_DESCRIPTION,
	areaServed: 'US',
	currenciesAccepted: 'USD',
	paymentAccepted: 'PayPal',
	slogan: 'Ready when networks fail.',
};

const primaryTopics = ['Range', 'Battery life', 'Programming', 'Customization'];
const shortQuestions: Record<string, string> = {
	Range: 'How far can they reach?',
	'Battery life': 'How long do the batteries last?',
	Programming: 'Which channels are included?',
	Customization: 'Can I customize my kit?',
};
const shopQuestions = [
	{ topic: 'Ordering', id: 'how-it-works', question: 'How does ordering work?', answer: 'Choose a kit and select any available options in the PayPal cart. We program, check, and pack your radios in Maryland, then ship your complete kit to you.' },
	{ topic: 'Shipping & payment', id: 'policies', question: 'What about shipping and payment?', answer: 'Shipping is always free within the United States. We do not currently ship internationally. PayPal handles checkout and payment details; this website does not store your card information.' },
];
const primaryQuestions = [
	...faqs.filter(faq => primaryTopics.includes(faq.topic)).map(faq => ({ ...faq, question: shortQuestions[faq.topic] })),
	...shopQuestions,
];
const moreQuestions = faqs.filter(faq => !primaryTopics.includes(faq.topic));
const cardFit: Record<string, string> = {
	'2': 'For couples and small teams.',
	'4': 'For families and group use.',
	'5': 'For larger teams. Bigger case.',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [...primaryQuestions, ...moreQuestions].map(faq => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};

const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Signal Ready radio kits',
	itemListElement: products.map((product, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		item: productStructuredData(product),
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/og-v2.png" />
		<meta name="theme-color" content="#303a31" />
		<script type="application/ld+json" set:html={JSON.stringify(storeSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
	</head>
	<body>
		<SiteHeader isHome />
		<main class="simple-store" id="main">
			<noscript><p class="noscript-notice">PayPal checkout requires JavaScript. <a href="mailto:ansman@gmail.com?subject=Signal%20Ready%20order">Email Signal Ready to order.</a></p></noscript>
			<section class="shop-intro" id="top" aria-labelledby="intro-title">
				<h1 id="intro-title">Ready when <em>networks fail.</em></h1>
				<p>Pre-programmed radio kits for family, travel, and teams.<br class="desktop-break" /> No cell service or subscription required.</p>
			</section>

			<section class="simple-shop" id="shop" aria-labelledby="shop-title">
				<div class="simple-section-heading">
					<h2 id="shop-title">Choose your kit.</h2>
					<p>Radios, batteries, case, charging cables, and programming included.</p>
				</div>
				<div class="kit-choices">
					{products.map(product => (
						<article class="shop-kit-card" id={product.id} aria-labelledby={`card-title-${product.id}`}>
							<a class="shop-kit-photo" href={product.path} aria-label={`View ${product.name} photos and details`}>
								<img src={product.images[0].src} alt={product.images[0].alt} width="1086" height="1448" loading="eager" decoding="async" />
							</a>
							<div class="shop-kit-copy">
								<p class="shop-kit-model">{product.selectorBadge ? 'Next-gen Mini-5' : 'UV-5R Mini'}<span>{product.battery}</span></p>
								<h3 id={`card-title-${product.id}`}><a href={product.path}>{product.name}</a></h3>
								<p class="shop-kit-fit">{cardFit[product.radioCount]}</p>
								<strong class="shop-kit-price">{product.price}</strong>
							</div>
							<div class="shop-kit-actions">
								<button class="button-buy" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`} aria-label={`Buy ${product.name} online`}>Buy online</button>
								<a href={product.path} aria-label={`Photos and details for ${product.name}`}>Photos &amp; details</a>
							</div>
						</article>
					))}
				</div>
				<details class="kit-comparison" id="compare">
					<summary>
						<span><small>Models · batteries · case sizes</small><strong>Compare every kit</strong></span>
						<span class="comparison-toggle" aria-hidden="true">+</span>
					</summary>
					<p class="comparison-mobile-hint" aria-hidden="true">Swipe to compare all kits →</p>
					<div class="comparison-table-wrap" tabindex="0" role="region" aria-label="Kit comparison table; scroll horizontally to see all kits">
						<table>
							<caption class="sr-only">Comparison of Signal Ready two-, four-, and five-radio field kits</caption>
							<thead>
								<tr>
									<th scope="col">Kit details</th>
									{products.map(product => <th scope="col"><a href={product.path}>{product.name}</a><small>{product.label}</small></th>)}
								</tr>
							</thead>
							<tbody>
								<tr class="comparison-price"><th scope="row">Price</th>{products.map(product => <td>{product.price}<small>Free U.S. shipping</small></td>)}</tr>
								<tr><th scope="row">Radios</th>{products.map(product => <td>{product.radioCount}</td>)}</tr>
								<tr><th scope="row">Radio model</th>{products.map(product => <td>{product.model}{product.selectorBadge && <small>Next generation</small>}</td>)}</tr>
								<tr><th scope="row">Battery</th>{products.map(product => <td>{product.battery} each</td>)}</tr>
								<tr><th scope="row">Charging</th>{products.map(product => <td>{product.charging}</td>)}</tr>
								<tr><th scope="row">Case size</th>{products.map(product => <td>{product.caseSize}</td>)}</tr>
								<tr><th scope="row">Best for</th>{products.map(product => <td>{product.bestFor}</td>)}</tr>
								<tr class="comparison-actions">
									<th scope="row">Order</th>
									{products.map(product => (
										<td><button class="comparison-buy" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`}>Buy {product.radioCount}-radio kit <span aria-hidden="true">→</span></button></td>
									))}
								</tr>
							</tbody>
						</table>
					</div>
				</details>

			</section>

			<section class="simple-faq" id="faq" aria-labelledby="faq-title">
				<div class="simple-section-heading">
					<h2 id="faq-title">FAQ</h2>
					<p>A few answers before you order.</p>
				</div>
				<FaqList items={primaryQuestions} />
				<details class="more-questions" id="more-questions">
					<summary>More radio questions <span aria-hidden="true">+</span></summary>
					<FaqList items={moreQuestions} />
				</details>
			</section>
		</main>
		<SiteFooter isHome />
		<StorefrontDialogs products={products} />
		<StorefrontScripts />
	</body>
</html>
