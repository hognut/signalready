---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const products = [
	{
		id: 'two-radio-kit',
		name: '2-Radio Field Kit',
		model: 'Baofeng Mini-5',
		selectorBadge: 'Next-generation radio',
		selectorModel: 'Mini-5 · 2,200mAh',
		price: '$125',
		paypalId: 'ZZL7S6UZS5VKN',
		radioCount: '2',
		battery: '2,200mAh',
		caseSize: '9¼ × 7½ × 4⅜ in.',
		charging: '1-to-2 USB-C splitter',
		label: 'Newer-generation radio',
		bestFor: 'Vehicles, couples, travel, and small teams',
		selectorStats: [
			{ label: 'Radios', value: '2' },
			{ label: 'Battery', value: '2,200mAh' },
			{ label: 'Case length', value: '9¼ in.' },
		],
		description: 'Built around the newer Baofeng Mini-5, with a 2,200mAh battery, improved audio and reception, and an easier-to-use keypad—all in a streamlined package for vehicles, travel, and small teams.',
		fullDescription: null,
		highlights: ['Newer Mini-5 platform', '2,200mAh battery', 'Improved audio, reception, and keypad'],
		images: [
			{ src: '/images/two-kit-open.jpg', alt: 'Two Baofeng handheld radios beside an open protective hard case' },
			{ src: '/images/two-kit-packed.jpg', alt: 'Two radios and charging accessories secured inside a fitted hard case' },
			{ src: '/images/two-kit-closed.jpg', alt: 'Closed black two-radio kit case with a compact black USB-C splitter cable' },
		],
		included: [
			'2 Baofeng Mini-5 HAM-version radios',
			'2,200mAh rechargeable batteries installed',
			'Custom-fitted protective hard case',
			'Precision-cut foam insert',
			'1-to-2 USB-C charging splitter',
			'Custom exterior identification badge',
			'Case exterior: 9¼ × 7½ × 4⅜ in.',
		],
	},
	{
		id: 'four-radio-kit',
		name: '4-Radio Field Kit',
		model: 'Baofeng UV-5R Mini',
		price: '$200',
		paypalId: '7L264VEBTJMMQ',
		radioCount: '4',
		battery: '1,600mAh',
		caseSize: '9¼ × 7½ × 4⅜ in.',
		charging: '1-to-4 USB-C splitter',
		label: 'Complete system',
		bestFor: 'Families, teams, and preparedness kits',
		selectorStats: [
			{ label: 'Radios', value: '4' },
			{ label: 'Battery', value: '1,600mAh' },
			{ label: 'Case length', value: '9¼ in.' },
		],
		description: 'A compact four-radio communications package, professionally programmed and organized for immediate deployment.',
		fullDescription: null,
		highlights: ['Four-radio team setup', 'Custom programming', '1-to-4 USB-C charging'],
		images: [
			{ src: '/images/four-kit-open.jpg', alt: 'Four Baofeng handheld radios beside an open Signal Ready hard case' },
			{ src: '/images/four-kit-packed.jpg', alt: 'Four radios and charging accessories organized inside a protective hard case' },
			{ src: '/images/four-kit-closed.jpg', alt: 'Closed black protective radio case in a charcoal studio with lime edge lighting' },
		],
		included: [
			'4 Baofeng UV-5R Mini HAM-version radios',
			'Rechargeable batteries installed',
			'Custom-fitted protective hard case',
			'Precision-cut foam insert',
			'1-to-4 USB-C charging splitter',
			'Custom exterior identification badge',
			'Case exterior: 9¼ × 7½ × 4⅜ in.',
		],
	},
	{
		id: 'five-radio-kit',
		name: '5-Radio Field Kit',
		model: 'Baofeng Mini-5',
		selectorBadge: 'Next-generation radio',
		selectorModel: '5 × Mini-5 · 2,200mAh',
		price: '$300',
		paypalId: 'Z5NELZMQT6M24',
		radioCount: '5',
		battery: '2,200mAh',
		caseSize: '13½ × 11⅜ × 6 in.',
		charging: '5 USB-A to USB-C cables',
		label: 'Next-generation team system',
		bestFor: 'Larger teams, events, families, and field operations',
		selectorStats: [
			{ label: 'Radios', value: '5' },
			{ label: 'Battery', value: '2,200mAh' },
			{ label: 'Case length', value: '13½ in.' },
		],
		description: 'Built around five next-generation Baofeng Mini-5 radios, each with a 2,200mAh battery, improved audio and reception, and an easier-to-use keypad—all organized in a larger five-slot field case.',
		fullDescription: `Professionally assembled five-radio communications kit built around the next-generation Baofeng Mini-5 HAM-version radio. This larger team system keeps five compact handhelds protected, organized, and ready for quick deployment in a durable hard case with a precision-cut five-slot foam insert.

Each Mini-5 includes a 2,200mAh rechargeable battery, improved audio and reception, and an easier-to-use keypad compared with the UV-5R Mini used in the four-radio kit. Every radio is professionally programmed before shipment with commonly used GMRS, FRS, MURS, NOAA weather, Marine, and select aviation monitoring channels. Custom channel plans are available upon request.

Included:
• 5 Baofeng Mini-5 HAM-version radios
• 5 installed 2,200mAh rechargeable batteries
• Larger 13½ × 11⅜ × 6 in. hard protective case
• Precision-cut five-slot foam insert and protective lid foam
• 5 standard USB-A to USB-C charging cables
• Custom exterior identification badge
• Pre-programmed channel configuration
• Free U.S. shipping

The larger case provides a secure position for each radio while keeping the complete system easy to carry, store in a vehicle, or stage with emergency equipment. It is well suited to families, security teams, event staff, vehicle recovery crews, overlanding groups, outdoor operations, and organizations that need more than a two- or four-radio setup.

The radios arrive organized and programmed for immediate setup and use. Actual range varies with terrain, buildings, foliage, antenna height, power, and line of sight.`,
		highlights: ['Five next-gen Mini-5 radios', '2,200mAh batteries', 'Improved audio, reception, and keypad'],
		images: [
			{ src: '/images/five-kit-radios-open-v2.jpg', alt: 'Five next-generation Baofeng Mini-5 radios beside an open five-slot protective hard case' },
			{ src: '/images/five-kit-radios-packed-v2.jpg', alt: 'Five next-generation Mini-5 radios secured inside custom-cut foam in the larger field case' },
			{ src: '/images/five-kit-closed.jpg', alt: 'Closed large black five-radio protective case in the Signal Ready studio' },
			{ src: '/images/five-kit-size-comparison.jpg', alt: 'Large five-radio case beneath the smaller case used for two- and four-radio kits' },
		],
		included: [
			'5 Baofeng Mini-5 HAM-version radios',
			'2,200mAh rechargeable batteries installed',
			'Larger protective hard case',
			'Precision-cut five-slot foam insert',
			'5 standard USB-A to USB-C charging cables',
			'Custom exterior identification badge',
			'Case exterior: 13½ × 11⅜ × 6 in.',
			'Free shipping within the United States',
		],
	},
];

const programming = ['GMRS channels', 'FRS channels', 'MURS channels', 'NOAA weather', 'Marine channels', 'Aviation monitoring'];

const rangeGuide = [
	{ label: 'Dense or built-up areas', value: '½–2 mi', note: 'Buildings, vehicles, heavy foliage, and uneven ground reduce range.' },
	{ label: 'Open, relatively clear terrain', value: '2–5 mi', note: 'A practical expectation when both radios have a clearer path.' },
	{ label: 'Best-case elevated line of sight', value: '10–20+ mi', note: 'High, unobstructed positions can go much farther than street level.', best: true },
];

const faqs = [
	{
		topic: 'Range',
		question: 'How far can these handheld radios transmit?',
		answer: 'Think in terms of line of sight, not a fixed coverage radius. Between two handhelds, roughly ½–2 miles is realistic in dense neighborhoods, buildings, vehicles, or heavy woods; around 2–5 miles is possible across open, relatively clear terrain. In a best-case setup with both operators elevated and a clean, unobstructed path, 10–20+ miles can be achievable, and exceptional summit-to-summit paths may go farther. Hills, valleys, steel structures, wet foliage, and holding the radio low can reduce range sharply. A well-positioned repeater can provide much wider regional coverage.',
	},
	{
		topic: 'Battery life',
		question: 'How long do the batteries last, and which radio has the larger battery?',
		answer: 'The UV-5R Mini uses a 1,600mAh battery. The next-generation Mini-5 included in the 2- and 5-radio kits has a 2,200mAh battery—600mAh, or 37.5%, more rated capacity. A full charge can often cover a day of light, intermittent use; heavy transmitting, high power, scanning, cold weather, and battery age shorten runtime. USB-C makes vehicle or power-bank top-ups easy.',
	},
	{
		topic: 'Programming',
		question: 'Which channels are pre-programmed?',
		answer: 'The standard channel plan includes commonly used GMRS, FRS, and MURS channels; NOAA weather; Marine channels; and selected aviation monitoring frequencies. Custom channel plans can be requested before shipment.',
	},
	{
		topic: 'Radio services',
		question: 'What is the difference between HAM, GMRS, FRS, and MURS?',
		answer: 'HAM offers broad flexibility and repeater access. GMRS is popular for family and group communication, while FRS and MURS are commonly used for shorter-range personal or team communication. Each service has different capabilities, but the practical goal is the same: clear, organized communication.',
	},
	{
		topic: 'Responsible use',
		question: 'What should I know before using the radios?',
		answer: 'Users are responsible for safe, responsible, and lawful use of the radios.',
	},
	{
		topic: 'Extended range',
		question: 'What is a repeater, and how can it improve range?',
		answer: 'A repeater receives a radio signal at a well-positioned site—often on a tower, hill, or tall building—and retransmits it over a wider area. That higher antenna can reach around terrain and structures that block direct handheld-to-handheld communication. Repeater access depends on compatible programming and the repeater’s operating setup.',
	},
	{
		topic: 'Privacy',
		question: 'Do “privacy codes” make a conversation private?',
		answer: 'No. CTCSS and DCS tones only filter which signals open your radio’s speaker. Anyone listening on the same frequency without that filter can still hear the transmission. They reduce unwanted chatter; they do not encrypt it.',
	},
	{
		topic: 'Compatibility',
		question: 'Will these radios communicate with other brands?',
		answer: 'Usually yes when the radios use the same frequency, channel width, tone settings, and repeater configuration. Brand names do not have to match. Signal Ready can help coordinate a compatible channel plan for your team’s existing equipment.',
	},
	{
		topic: 'Performance',
		question: 'Does programming increase range?',
		answer: 'No. Programming makes the radio faster and easier to use, but range depends mainly on antenna height and quality, terrain, obstructions, frequency, transmit power, and repeater access. Moving to higher, clearer ground is often the most effective improvement.',
	},
	{
		topic: 'Charging',
		question: 'How is the 5-radio kit charged?',
		answer: 'The kit includes five standard USB-A to USB-C charging cables—one for each Mini-5 radio. The individual cables make it easier to charge from compatible wall adapters, vehicle USB ports, power stations, or other USB-A power sources without relying on one proprietary multi-head splitter.',
	},
];

const storeSchema = {
	'@context': 'https://schema.org',
	'@type': 'OnlineStore',
	name: 'Signal Ready',
	url: 'https://radios.ansman.io',
	email: 'ansman@gmail.com',
	description: SITE_DESCRIPTION,
	areaServed: 'US',
	currenciesAccepted: 'USD',
	paymentAccepted: 'PayPal',
	slogan: 'Ready when networks fail.',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(faq => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};

const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Signal Ready radio kits',
	itemListElement: products.map((product, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		item: {
			'@type': 'Product',
			name: product.name,
			description: product.description,
			image: product.images.map(image => `https://radios.ansman.io${image.src}`),
			brand: { '@type': 'Brand', name: 'Signal Ready' },
			model: product.model,
			offers: {
				'@type': 'Offer',
				url: `https://radios.ansman.io/#${product.id}`,
				priceCurrency: 'USD',
				price: product.price.replace(/[^0-9.]/g, ''),
				seller: { '@type': 'Organization', name: 'Signal Ready' },
			},
		},
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/og-v2.png" />
		<meta name="theme-color" content="#303a31" />
		<script type="application/ld+json" set:html={JSON.stringify(storeSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="utility-bar">
			<div><span>Free shipping</span> anywhere in the United States</div>
			<div>Assembled in Maryland <i aria-hidden="true"></i> Veteran owned business</div>
		</div>

		<header class="site-header">
			<a class="brand" href="#top" aria-label="Signal Ready home">
				<img class="brand-logo" src="/images/signal-ready-logo-lime.png" alt="" width="40" height="40" />
				<span>SIGNAL <strong>READY</strong></span>
			</a>
			<nav aria-label="Main navigation">
				<a href="#shop" data-nav-link>Shop</a>
				<a href="#how-it-works" data-nav-link>How it works</a>
				<a href="#field-ready" data-nav-link>What you get</a>
				<a href="#faq" data-nav-link>FAQ</a>
				<a href="#about" data-nav-link>About</a>
				<a href="#policies" data-nav-link>Policies</a>
			</nav>
			<details class="mobile-menu">
				<summary>Menu</summary>
				<nav aria-label="Mobile navigation">
					<a href="#shop" data-nav-link>Shop</a>
					<a href="#how-it-works" data-nav-link>How it works</a>
					<a href="#field-ready" data-nav-link>What you get</a>
					<a href="#faq" data-nav-link>FAQ</a>
					<a href="#about" data-nav-link>About</a>
					<a href="#policies" data-nav-link>Policies</a>
				</nav>
			</details>
			<div class="cart-control" aria-label="Shopping cart">
				<paypal-cart-button data-id="pp-view-cart"></paypal-cart-button>
			</div>
		</header>

		<main id="main">
			<noscript><p class="noscript-notice">PayPal checkout requires JavaScript. <a href="mailto:ansman@gmail.com?subject=Signal%20Ready%20order">Email Signal Ready to order.</a></p></noscript>
			<section class="hero" id="top">
				<div class="hero-copy">
					<p class="eyebrow">Field-ready communication systems</p>
					<h1>Ready when<br /><em>networks fail.</em></h1>
					<p class="lede">Professionally assembled, pre-programmed radio kits built for preparedness, travel, team coordination, and off-grid communication.</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#shop">Shop the systems <span aria-hidden="true">↓</span></a>
						<div class="availability"><span aria-hidden="true"></span> Built and shipped from Maryland</div>
					</div>
				</div>
				<div class="hero-visual">
					<div class="image-frame">
						<img src="/images/hero-field-kit.jpg" alt="Four handheld radios, an open protective case, and a charging cable arranged on a truck tailgate at dusk" width="1350" height="1800" fetchpriority="high" />
					</div>
					<div class="hero-image-label"><span>SR–04</span><strong>Field system</strong></div>
					<div class="status-card"><span aria-hidden="true"></span> Programmed · Packed · Ready</div>
					<div class="coordinates" aria-hidden="true">38.7218° N<br />76.6605° W</div>
				</div>
			</section>

			<section class="trust-strip" aria-label="Store benefits">
				<div><strong>01</strong><span>Pre-programmed<br />before delivery</span></div>
				<div><strong>02</strong><span>Organized in a<br />custom foam case</span></div>
				<div><strong>03</strong><span>Free shipping<br />across the U.S.</span></div>
				<div><strong>04</strong><span>Veteran owned<br />business</span></div>
			</section>

			<section class="process-section" id="how-it-works" aria-labelledby="process-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">From the bench to your door</p>
						<h2 id="process-title">Ready in<br />three steps.</h2>
					</div>
					<p>No complicated setup list. Choose the right kit, tell us what you need, and receive an organized system ready for the field.</p>
				</div>
				<ol class="process-grid">
					<li><span>01</span><h3>Choose your system</h3><p>Select a complete two-, four-, or five-radio kit for your household, vehicle, or team.</p></li>
					<li><span>02</span><h3>We configure it</h3><p>Your complete radio kit is programmed, checked, organized, and packed in Maryland.</p></li>
					<li><span>03</span><h3>It ships free</h3><p>Your order ships free anywhere in the United States, with direct support from the builder.</p></li>
				</ol>
			</section>

			<section class="shop-section" id="shop">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Choose your setup</p>
						<h2>Built for the field.<br />Not the shelf.</h2>
					</div>
					<p>Every system is carefully organized and prepared for quick deployment—without a complicated setup process.</p>
				</div>

				<div class="setup-selector" aria-label="Compare Signal Ready setups">
					{products.map((product, index) => (
						<article class:list={{ 'setup-option': true, 'setup-option-nextgen': Boolean(product.selectorBadge) }}>
							<div class="setup-option-top">
								<span>{String(index + 1).padStart(2, '0')}</span>
								<small>{product.paypalId ? 'Ready to order' : 'Ask about availability'}</small>
							</div>
							<div class="setup-option-visual">
								<img class="setup-option-image" src={product.images[0].src} alt="" width="1086" height="1448" loading="lazy" decoding="async" />
								<div class="setup-option-copy">
									{product.selectorBadge && <span class="setup-option-badge">{product.selectorBadge}</span>}
									<a class="setup-option-title" href={`#${product.id}`}>{product.name}</a>
									<p>{product.bestFor}</p>
								</div>
							</div>
							<div class="setup-option-specs" aria-label={`${product.name} quick specifications`}>
								{product.selectorStats.map(stat => <span><small>{stat.label}</small><strong>{stat.value}</strong></span>)}
							</div>
							<div class="setup-option-meta"><b>{product.price}</b><em>{product.selectorModel ?? product.model}</em></div>
							{product.paypalId ? (
								<button class="setup-buy-button" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`} aria-label={`Buy ${product.name} online`}>
									<span>Buy online</span><b aria-hidden="true">→</b>
								</button>
							) : (
								<a class="setup-buy-button" href={`mailto:ansman@gmail.com?subject=${encodeURIComponent(`Signal Ready — ${product.name}`)}`}><span>Ask about availability</span><b aria-hidden="true">→</b></a>
							)}
							<a class="setup-detail-link" href={`#${product.id}`}>View complete kit details <span aria-hidden="true">↓</span></a>
						</article>
					))}
				</div>

				<details class="kit-comparison" id="compare" open>
					<summary>
						<span><small>At a glance</small><strong>Compare every kit</strong></span>
						<span class="comparison-toggle" aria-hidden="true">+</span>
					</summary>
					<p class="comparison-mobile-hint" aria-hidden="true">Swipe to compare all kits →</p>
					<div class="comparison-table-wrap">
						<table>
							<caption class="sr-only">Comparison of Signal Ready two-, four-, and five-radio field kits</caption>
							<thead>
								<tr>
									<th scope="col">Kit details</th>
									{products.map(product => <th scope="col"><a href={`#${product.id}`}>{product.name}</a><small>{product.label}</small></th>)}
								</tr>
							</thead>
							<tbody>
								<tr class="comparison-price"><th scope="row">Price</th>{products.map(product => <td>{product.price}<small>Free U.S. shipping</small></td>)}</tr>
								<tr><th scope="row">Radios</th>{products.map(product => <td>{product.radioCount}</td>)}</tr>
								<tr><th scope="row">Radio model</th>{products.map(product => <td>{product.model}{product.selectorBadge && <small>Next generation</small>}</td>)}</tr>
								<tr><th scope="row">Battery</th>{products.map(product => <td>{product.battery} each</td>)}</tr>
								<tr><th scope="row">Charging</th>{products.map(product => <td>{product.charging}</td>)}</tr>
								<tr><th scope="row">Case size</th>{products.map(product => <td>{product.caseSize}</td>)}</tr>
								<tr><th scope="row">Best for</th>{products.map(product => <td>{product.bestFor}</td>)}</tr>
								<tr class="comparison-actions">
									<th scope="row">Order</th>
									{products.map(product => (
										<td><button class="comparison-buy" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`}>Buy {product.radioCount}-radio kit <span aria-hidden="true">→</span></button></td>
									))}
								</tr>
							</tbody>
						</table>
					</div>
				</details>

				<aside class="selection-help" aria-label="Help choosing a radio kit">
					<h3>Not sure which kit fits?</h3>
					<p><strong>Choose 2</strong> for a vehicle or pair, <strong>4</strong> for a family or small team, and <strong>5</strong> when you need the next-generation radios for a larger group.</p>
					<a href="mailto:ansman@gmail.com?subject=Help%20choosing%20a%20Signal%20Ready%20kit">Ask the builder <span aria-hidden="true">→</span></a>
				</aside>

				<div class="product-grid">
					{products.map((product, index) => (
						<article class="product-card" id={product.id}>
							<div class="product-gallery" data-gallery>
								<div class="product-label"><span>{String(index + 1).padStart(2, '0')}</span>{product.label}</div>
								<img class="product-main-image" src={product.images[0].src} alt={product.images[0].alt} width="1086" height="1448" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" data-main-image />
								<div class="product-thumbnails" aria-label={`${product.name} photos`}>
									{product.images.map((image, imageIndex) => (
										<button type="button" class:list={{ active: imageIndex === 0 }} data-gallery-button data-src={image.src} data-alt={image.alt} aria-label={`Show ${product.name} photo ${imageIndex + 1}`} aria-pressed={imageIndex === 0 ? 'true' : 'false'}>
											<img src={image.src} alt="" width="72" height="72" loading="lazy" decoding="async" />
										</button>
									))}
								</div>
							</div>
							<div class="product-info">
								<p class="product-model">{product.model}</p>
								<h3>{product.name}</h3>
								<p class="product-description">{product.description}</p>
								<ul class="product-highlights" aria-label={`${product.name} highlights`}>
									{product.highlights.map(item => <li>{item}</li>)}
								</ul>
								<ul class="check-list">
									{product.included.map(item => <li>{item}</li>)}
								</ul>
								{product.fullDescription && (
									<details class="item-description">
										<summary>Read the full item description <span aria-hidden="true">+</span></summary>
										<p>{product.fullDescription}</p>
									</details>
								)}
								<div class="product-purchase">
									<div class="product-price">{product.price}<span>Free U.S. shipping</span></div>
									{product.paypalId ? (
										<button class="button-buy" type="button" data-open-paypal data-dialog-id={`paypal-product-dialog-${product.id}`} data-email-subject={`Signal Ready — ${product.name}`}>Configure & add to cart</button>
									) : (
										<a class="button-inquiry" href={`mailto:ansman@gmail.com?subject=${encodeURIComponent(`Signal Ready — ${product.name}`)}`}>Ask about availability</a>
									)}
								</div>
